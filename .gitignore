# Dependencies
node_modules

# Build output
.next/
# Staging/retired build dirs used by deploy.sh's atomic swap
.next.new/
.next.old/
out/
dist/
*.tsbuildinfo

# Deploy bookkeeping (VPS-local, never committed)
.deploy.lock
.deploy.last-success

# Environment variables
.env
.env*.local

# Logs
*.log

# Test artifacts (Playwright)
test-results/
playwright-report/

# Runtime log reporter worktree (checkout of the runtime-logs branch).
# Kept out of the code branch so it never shows as untracked / conflicts.
.runtime-logs/

# OS / editor
.DS_Store

# Local tooling artifacts
.snowflake/
.v0-trash/
.vercel/
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
# Server/ops backups — NEVER commit. Contains pm2 dumps (which serialize the
# full process env, including DATABASE_URL and secrets), SSL private keys, and
# raw DB dumps. Keep the whole directory out of the repo.
backup/
