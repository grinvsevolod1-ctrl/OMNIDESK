# --- Omnidesk environment (self-hosted on your VPS) ---

# PostgreSQL connection string. Point this at your own Postgres.
# Local example:    postgresql://omnidesk:secret@localhost:5432/omnidesk
# Managed example:  postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=
# Apply all pending migrations once configured: pnpm db:migrate

# --- Database TLS ---
# When the connection uses TLS (sslmode=require in DATABASE_URL, or set
# DATABASE_SSL=true) the server certificate is VERIFIED by default to prevent
# MITM. For managed/self-signed providers, paste the CA certificate (PEM) here:
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Only as a last resort (e.g. a trusted private network) you may disable
# verification — this is insecure and never recommended:
# DATABASE_SSL_NO_VERIFY=true

# --- Reverse proxy ---
# Client IPs (used only as rate-limit keys) are read from x-forwarded-for /
# x-real-ip. This is correct when a trusted reverse-proxy (nginx/Caddy/
# Cloudflare) sits in front — the default. If you expose Node DIRECTLY with no
# trusted proxy, set this to false so clients can't spoof their IP to bypass
# per-IP throttling (including login brute-force protection).
# TRUST_PROXY=false

# Administrator login (no admin row is stored in the database).
# ADMIN_USERNAME is optional; it defaults to the local-part of ADMIN_EMAIL.
# The admin is authenticated purely from these vars and is intentionally kept
# out of the managers pool (never assignable / blockable via the manager UI).
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-this-strong-password
# ADMIN_USERNAME=admin

# --- AI assistant & client simulator (Vercel AI Gateway) ---
# API key for the Vercel AI Gateway. Required for the AI manager-assistant
# (auto-replies + training) and the client simulator to reach the models.
AI_GATEWAY_API_KEY=
# Optional model overrides (sensible defaults apply when unset).
# Model that composes manager-side replies for the AI assistant (default gpt-4.1):
# MANAGER_AI_MODEL=openai/gpt-4.1
# Model that role-plays the client persona in the simulator (default gpt-4.1-mini):
# CLIENT_SIM_MODEL=openai/gpt-4.1-mini

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
# REQUIRED in production — the app refuses to start without a strong value.
AUTH_SECRET=

# Required by /api/cron/sync-ads. Generate with: openssl rand -base64 32
# The endpoint fails closed when this value is missing.
CRON_SECRET=

# --- Web Push notifications (manager browser/mobile alerts) ---
# VAPID keypair for the standard Web Push protocol. Generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is exposed to the browser; keep the private key server-side.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact required by the spec (mailto: or https:). Optional; a default applies.
VAPID_SUBJECT=mailto:admin@yourcompany.com

# --- Engine (real Telegram / WhatsApp sessions) ---

# 32-byte key used to encrypt all channel secrets at rest.
# Generate with: openssl rand -hex 32
# MUST be identical in the panel and the worker (both accept hex or base64).
ENCRYPTION_KEY=

# Shared secret for the panel <-> worker internal HTTP API.
# Generate with: openssl rand -base64 32
WORKER_SECRET=

# Port the worker's internal HTTP API binds to (localhost only).
WORKER_PORT=4000

# URL the panel uses to reach the worker (must match WORKER_PORT).
WORKER_URL=http://127.0.0.1:4000

# Telegram API credentials from https://my.telegram.org (worker only, but
# listed here for reference). Required to log in personal Telegram accounts.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
