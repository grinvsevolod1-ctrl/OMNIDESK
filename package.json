{
  "name": "omnidesk-panel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm build:widget && next build",
    "build:widget": "node scripts/build-widget.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "pnpm --dir worker typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:browser": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.development.local scripts/migrate.mjs up",
    "db:status": "node --env-file-if-exists=.env.development.local scripts/migrate.mjs status",
    "check": "pnpm lint && pnpm typecheck && pnpm typecheck:worker && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "ai": "^7.0.22",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "https-proxy-agent": "^9.0.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "socks": "^2.8.9",
    "socks-proxy-agent": "^10.0.0",
    "sonner": "^2.0.7",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.3.1",
    "telegram": "^2.26.22",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.16"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16",
    "postcss": "^8.5.16",
    "shadcn": "^4.8.0",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  }
}
