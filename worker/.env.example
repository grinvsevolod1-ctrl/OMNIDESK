# --- Worker environment ---
# Must match the panel's DATABASE_URL and ENCRYPTION_KEY exactly.

# Postgres (same database the panel uses)
DATABASE_URL=postgres://user:pass@localhost:5432/omnidesk

# 32-byte key. Generate with: openssl rand -hex 32
# MUST be identical to the panel's ENCRYPTION_KEY or secrets won't decrypt.
ENCRYPTION_KEY=

# Shared secret for the panel -> worker internal API. Generate with: openssl rand -hex 32
WORKER_SECRET=

# Internal HTTP API port (panel calls 127.0.0.1:WORKER_PORT)
WORKER_PORT=4000

# Telegram API credentials from https://my.telegram.org (API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional MTProto device metadata (keep stable to avoid re-login / bans)
TELEGRAM_DEVICE_MODEL=Omnidesk Desktop
TELEGRAM_SYSTEM_VERSION=Linux
TELEGRAM_APP_VERSION=1.0.0

LOG_LEVEL=info
NODE_ENV=production
