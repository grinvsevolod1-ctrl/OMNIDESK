  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@sentry/node": "^10.69.0",
    "dotenv": "^16.4.7",
    "https-proxy-agent": "^9.0.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "socks-proxy-agent": "^8.0.4",
    "ssh2": "^1.17.0",
    "teleproto": "^1.228.5",
    "tsx": "^4.19.2",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2"
  }
